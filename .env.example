# Скопируйте в .env. Он исключён из Git. Пароли сюда, не в Python/SQL.
TRUCKS_DB_HOST=localhost
TRUCKS_DB_PORT=5432
TRUCKS_DB_NAME=fleet_demo_local
TRUCKS_DB_USER=postgres
# Раскомментируйте и заполните. При python main.py без этой строки будет запрос в терминале.
# TRUCKS_DB_PASSWORD=your-local-postgresql-password

# Необязательно: если не заданы, сервер создаст локальные секретные файлы.
# SESSION_SECRET_KEY=replace-with-at-least-32-random-characters
# GPS_INGEST_TOKEN=replace-with-at-least-32-random-characters
SESSION_HTTPS=0
